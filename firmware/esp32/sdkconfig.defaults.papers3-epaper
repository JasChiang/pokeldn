# PaperS3's embedded R8 memory is Octal PSRAM. Keep ordinary radio allocations
# in internal RAM; only the display explicitly requests MALLOC_CAP_SPIRAM.
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_USE_CAPS_ALLOC=y
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=n
# If external RAM is missing, keep the radio running and report display failure.
CONFIG_SPIRAM_IGNORE_NOTFOUND=y
